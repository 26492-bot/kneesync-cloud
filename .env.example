# ============================================================
#  KneeSync AI — Cloud Configuration
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามต้องการ
# ============================================================

# Server port
PORT=3000

# LINE Messaging API (สำหรับแจ้งเตือน Fall Risk สูง)
LINE_TOKEN=your_line_channel_access_token
LINE_USER_ID=your_line_user_id

# Gemini AI API Key (สำหรับ AI Clinical Insight)
GEMINI_API_KEY=your_gemini_api_key
