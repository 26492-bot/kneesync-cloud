# ============================================================
#  KneeSync AI — Cloud Configuration
#  คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามต้องการ
# ============================================================

# Server port
PORT=3000

# ============================================================
#  Admin Account
#  รหัสผ่าน Admin ที่ใช้ seed ครั้งแรก
#  ถ้าไม่ตั้งค่า ระบบจะสร้าง random password แล้วแสดงใน console
# ============================================================
ADMIN_DEFAULT_PASSWORD=

# ============================================================
#  LINE Messaging API (แจ้งเตือน Fall Risk สูง > 70%)
#  วิธีตั้งค่า:
#  1. สร้าง LINE Official Account ที่ https://developers.line.biz/
#  2. เปิด Messaging API ใน LINE Developers Console
#  3. คัดลอก Channel Access Token → ใส่ใน LINE_TOKEN
#  4. คัดลอก User ID ของผู้รับ → ใส่ใน LINE_USER_ID
#     (ดู User ID ได้จาก LINE Developers Console > Basic settings)
# ============================================================
LINE_TOKEN=
LINE_USER_ID=

# ============================================================
#  Gemini AI API Key (สำหรับ AI Clinical Insight)
#  วิธีตั้งค่า:
#  1. ไปที่ https://aistudio.google.com/apikey
#  2. สร้าง API Key ใหม่
#  3. คัดลอก API Key → ใส่ใน GEMINI_API_KEY
#  ถ้าไม่ตั้งค่า ฟีเจอร์ AI Insight จะถูก skip โดยไม่มี error
# ============================================================
GEMINI_API_KEY=
